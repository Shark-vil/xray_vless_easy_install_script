{
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "%DOMAIN_NAME%",
      "server_port": 443,
      "uuid": "%CLIENT_UUID%",
      "tls": {
        "enabled": true,
        "server": "%DOMAIN_NAME%",
        "insecure": false,
        "flow": "",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "packet_encoding": "",
      "transport": {
        "type": "ws",
        "path": "/%WEBSOCKET_PATH%",
        "headers": {
          "Host": "%DOMAIN_NAME%"
        }
      }
    }
  ]
}